# Copy to .env and fill in. LLM_MODEL is "<provider>:<model>".
# Anthropic and OpenAI are installed; for another provider add its langchain package to requirements.txt.
LLM_MODEL=anthropic:claude-opus-5-5
ANTHROPIC_API_KEY=REPLACE_ME
# LLM_MODEL=openai:gpt-5
# OPENAI_API_KEY=REPLACE_ME
# Model that grades the eval. Defaults to LLM_MODEL.
# JUDGE_MODEL=openai:gpt-5
